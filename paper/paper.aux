\newlabel{sec:optim_soft@cref}{{[subsection][4][4]4.4}{[1][5][]5}{}{}{}}
\citation{jax2018}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Four-mode optimisation summary from Table~\ref {tab:optim_modes}. \textbf  {(a)} Baseline vs best $C_d$ per mode. \texttt  {halfway\_hard} cannot be optimised: its shape gradient is exactly zero. \texttt  {bouzidi\_hard} starts from a physical baseline ($C_d = 1.77$, close to the Clift dashed line) and reaches $1.66$ by shrinking the radius, the clean physical result. Both soft-porosity modes drive $C_d \to 0$ via the degenerate ``grow to plug the channel'' solution discussed in \Cref  {sec:optim_soft}. \textbf  {(b)} Average $|\partial C_d/\partial r|$ over 60 iterations. The classical halfway-hard bar is exactly zero (grey); every other mode has a non-zero gradient, but the porosity path dominates the magnitude in both soft modes, so the common ``Bouzidi gives stronger gradients'' comparison is mostly a statement about soft porosity rather than about Bouzidi itself.}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:optim_summary}{{3}{6}{Four-mode optimisation summary from Table~\ref {tab:optim_modes}. \textbf {(a)} Baseline vs best $C_d$ per mode. \texttt {halfway\_hard} cannot be optimised: its shape gradient is exactly zero. \texttt {bouzidi\_hard} starts from a physical baseline ($C_d = 1.77$, close to the Clift dashed line) and reaches $1.66$ by shrinking the radius, the clean physical result. Both soft-porosity modes drive $C_d \to 0$ via the degenerate ``grow to plug the channel'' solution discussed in \Cref {sec:optim_soft}. \textbf {(b)} Average $|\partial C_d/\partial r|$ over 60 iterations. The classical halfway-hard bar is exactly zero (grey); every other mode has a non-zero gradient, but the porosity path dominates the magnitude in both soft modes, so the common ``Bouzidi gives stronger gradients'' comparison is mostly a statement about soft porosity rather than about Bouzidi itself}{figure.caption.8}{}}
\newlabel{fig:optim_summary@cref}{{[figure][3][]3}{[1][5][]6}{}{}{}}
